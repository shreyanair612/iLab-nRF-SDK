 #include <dt-bindings/pinctrl/nrf-pinctrl.h>

&cpuapp_sram {
	reg = <0x20000000 0x7fe40>;
	ranges = <0x0 0x20000000 0x7fe40>;
};

&pinctrl {
	tdm_default: tdm_default {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M,1,23)>,
				<NRF_PSEL(TDM_FSYNC_M,1,22)>,
				<NRF_PSEL(TDM_SDIN,1,13)>;
		};
	};
};

&tdm {
	status = "okay";
	pinctrl-0 = <&tdm_default>;
	pinctrl-names = "default";
};

&axon {
	status = "okay";
};

/*
 * Telemetry link. uart20 is routed to the J-Link virtual COM port on the DK.
 * 1 Mbaud is the fastest rate the UARTE supports on this SoC; drop to 921600
 * if the host adapter cannot lock to it (see README, "link budget").
 */
&uart20 {
	current-speed = <1000000>;
};
