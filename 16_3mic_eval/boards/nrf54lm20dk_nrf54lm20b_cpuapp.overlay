/*
 * nRF54LM20 DK, 3-mic beamforming evaluation.
 *
 * 3x ICS-52000 TDM daisy chain (left / center / right):
 *   all SCK      -> P1.23  (TDM_SCK_M)
 *   all SD       -> P1.13  (TDM_SDIN), plus ~100k pulldown to GND
 *   nRF P1.22    -> WS  of left mic   (TDM_FSYNC_M, slot 0)
 *   left   WSO   -> WS  of center mic (slot 1)
 *   center WSO   -> WS  of right mic  (slot 2)
 *   right  WSO   -> not connected
 *   VDD -> 3V3, GND -> GND
 *
 * Links to the laptop (two cables):
 *   "nRF USB" USB-C port -> USB CDC ACM, audio + telemetry (this file, cdc_acm_uart0)
 *   "IMCU" USB port      -> J-Link: flashing, and uart20 debug console at 115200
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

&cpuapp_sram {
	reg = <0x20000000 0x7fe40>;
	ranges = <0x0 0x20000000 0x7fe40>;
};

&pinctrl {
	tdm_default: tdm_default {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M,1,23)>,
				<NRF_PSEL(TDM_FSYNC_M,1,22)>,
				<NRF_PSEL(TDM_SDIN,1,13)>;
		};
	};
};

&tdm {
	status = "okay";
	pinctrl-0 = <&tdm_default>;
	pinctrl-names = "default";
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		/* Large FIFOs: four 512-byte audio packets per 16 ms frame. */
		tx-fifo-size = <8192>;
		rx-fifo-size = <1024>;
	};
};

&uart20 {
	current-speed = <115200>;
};
